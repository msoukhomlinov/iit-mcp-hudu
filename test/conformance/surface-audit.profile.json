{
  "mcp_entrypoint": [
    "node",
    "dist/main.js"
  ],
  "node_repo": ".",
  "audit_line_pattern": "\"msg\":\"hudu request\"",
  "internal_patterns": [
    "\\bissues? #\\d+",
    "\\(#\\d+",
    "\\bINT-\\d+",
    "(?i)paperclip",
    "(?i)iit-mcp-hudu-private"
  ],
  "max_surface_bytes": 28000,
  "max_search_bytes": 2900,
  "min_headroom_bytes": 200,
  "max_tools": 19,
  "surface_calls": [
    {
      "tool": "hudu_list_operations",
      "params": {}
    },
    {
      "tool": "hudu_describe_operation",
      "params": {
        "operation": "articles.patchSection"
      }
    },
    {
      "tool": "hudu_describe_operation",
      "params": {
        "operation": "operations.searchKnowledge"
      }
    }
  ],
  "credentials_source": "test/conformance/surface-audit.placeholder.env"
}
