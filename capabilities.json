{
  "version": "0.4.0",
  "domain": "hudu",
  "capabilities": [
    {
      "id": "hudu.registry.list",
      "description": "List the operations the Hudu SDK implements, with the tool that exposes each one (when it has one), its effect, whether it needs a dry run or a confirmation flag, and the arguments it requires.",
      "mcpPrimitive": "tool",
      "toolName": "hudu_list_operations",
      "type": "read",
      "annotations": {
        "readOnly": true
      }
    },
    {
      "id": "hudu.registry.describe",
      "description": "Return the full input schema, effect, flags, dry-run support, error vocabulary, related operations and preferredWhen guidance for ONE operation, so a capability can be called correctly without carrying every schema...",
      "mcpPrimitive": "tool",
      "toolName": "hudu_describe_operation",
      "type": "read",
      "annotations": {
        "readOnly": true
      }
    },
    {
      "id": "hudu.registry.read",
      "description": "Execute only read operations by canonical registry key.",
      "mcpPrimitive": "tool",
      "toolName": "hudu_read",
      "type": "read",
      "annotations": {
        "readOnly": true
      }
    },
    {
      "id": "hudu.registry.write",
      "description": "Execute only write operations by canonical registry key.",
      "mcpPrimitive": "tool",
      "toolName": "hudu_write",
      "type": "write",
      "annotations": {
        "destructive": false
      },
      "gatedBy": "HUDU_WRITE_POLICY (registered only when not deny); dry-run by default"
    },
    {
      "id": "hudu.registry.delete",
      "description": "Execute only destructive operations by canonical registry key.",
      "mcpPrimitive": "tool",
      "toolName": "hudu_delete",
      "type": "write",
      "annotations": {
        "destructive": true
      },
      "gatedBy": "HUDU_WRITE_POLICY (registered only when not deny); dry-run by default"
    },
