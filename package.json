{
  "name": "iit-mcp-hudu",
  "version": "0.1.0",
  "description": "MCP server for Hudu IT documentation, built on the node-hudu SDK",
  "license": "MIT",
  "author": "Max Soukhomlinov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msoukhomlinov/iit-mcp-hudu.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hudu",
    "it-documentation"
  ],
  "type": "module",
  "bin": {
    "iit-mcp-hudu": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "node-hudu": "0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  }
}
