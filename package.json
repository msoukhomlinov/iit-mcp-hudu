{
  "name": "iit-mcp-hudu",
  "version": "0.11.1",
  "description": "MCP server for Hudu IT documentation, built on the node-hudu SDK",
  "license": "MIT",
  "author": "Max Soukhomlinov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msoukhomlinov/iit-mcp-hudu.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hudu",
    "it-documentation"
  ],
  "type": "module",
  "bin": {
    "iit-mcp-hudu": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "node-hudu": "0.24.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
