# The Hudu origin the server talks to -- REQUIRED for stdio, an optional default for http.
#
# stdio: the process IS the trust boundary, so the origin comes from the environment.
# http:  callers normally name their own origin per request in the X-Hudu-Base-Url header. When set,
#        this is the origin used by a request that sends no such header. The default key below is
#        only ever presented to this origin.
# HUDU_BASE_URL=https://hudu.example.com

# stdio (local: Claude Code, Claude Desktop, VS Code) or http (remote MCP clients).
MCP_TRANSPORT=stdio

# The server-held Hudu credential -- REQUIRED for stdio, an optional default for http.
#
# stdio: the process IS the trust boundary, so the key comes from the environment.
# http:  the key normally arrives per request in the X-Hudu-Api-Key header (a client can scope it
#        per user or per agent, so each caller reaches Hudu as itself). When set here, every request
#        WITHOUT its own key runs as this key, so set it only when that is intended. It is only ever
#        sent to HUDU_BASE_URL, never to a caller-named origin. Left commented so a copied example
#        does not set an empty value.
#
# HOW TO LOAD THIS FILE -- read before the first live call.
# ---------------------------------------------------------------------------------------------
# Source it with a shell, which is what consumes the single quotes the values below are written in:
#
#     set -a; . ./.env; set +a
#
# Do NOT use a quote-preserving dotenv parser (a plain KEY=VALUE split that keeps the quotes) on
# this file. It hands `'...'` -- quotes included -- to the server, and Hudu answers 401 for a
# credential that was never wrong. The trap is sharpest when the secret contains `$`:
# HUDU_API_KEY='a$b' is `a$b` when sourced and `'a$b'` when naively parsed, and both look correct
# in the file. A wrong credential is a real authentication failure against your Hudu account, and
# repeated ones risk an account lock.
#
# Then run the zero-wire preflight before any live session:
#
#     npx -y iit-mcp-hudu doctor        # or: node dist/main.js doctor
#
# It prints length + two-character prefix + shapeOk per credential field (never a value) and dials
# nothing, and exits non-zero when the credential would be refused. CONTRACT: a green doctor makes
# any later 401 vendor-side (rotated, revoked or role-restricted key) -- stop and check the vendor
# rather than re-dialing.
#
# The server enforces the same shape anyway: preserved surrounding quotes, an embedded quote, a
# carriage return, a newline, edge whitespace or a NUL byte in the value fails boot for
# HUDU_API_KEY, and is refused with CREDENTIAL_MALFORMED for a per-request X-Hudu-Api-Key.
# HUDU_API_KEY=

# http only, optional. Hosts a caller may name in X-Hudu-Base-Url: comma-separated exact hostnames or
# *.example.com subdomain suffixes (no scheme, port or path). Unset alongside a set HUDU_BASE_URL,
# only that default origin is accepted. Unset with no HUDU_BASE_URL, any caller-named origin would be
# accepted, so whoever can reach the listener could make the server dial hosts of their choosing:
# the server refuses to boot in that case unless HUDU_ALLOW_ANY_BASE_HOST=true. An explicit list
# never checks HUDU_BASE_URL against it.
# HUDU_ALLOWED_BASE_HOSTS=hudu.example.com,*.corp.example.com

# http only. Boot without an allow-list and accept any origin a caller names. Use only when every
# caller that can reach the listener is trusted.
# HUDU_ALLOW_ANY_BASE_HOST=false

# Deployment spectrum -- HUDU_WRITE_POLICY is the one switch for mutation, and every step is fail-closed:
#   read-only       : HUDU_WRITE_POLICY=deny (default). No hudu_write / hudu_delete tool exists.
#   scoped writes   : HUDU_WRITE_POLICY=allow_list + HUDU_WRITE_ALLOW=<operation keys>.
#   full read-write : HUDU_WRITE_POLICY=all. The SDK's per-mode client gates still apply underneath.
# Plaintext credential reads are a separate switch: HUDU_SECRET_READS=allow.

# Authority over the mutation dispatchers. deny (the default) registers no mutation tool; allow_list permits only the keys in HUDU_WRITE_ALLOW; all is today's behaviour and has
# to be typed out deliberately. Unset means deny. Reads are never affected.
HUDU_WRITE_POLICY=deny
# HUDU_WRITE_POLICY=allow_list
# HUDU_WRITE_POLICY=all
# Hard override: true means no write/delete tool and every mutation refused, whatever the policy and
# allow-list say. Unset or false leaves HUDU_WRITE_POLICY in charge.
# HUDU_READ_ONLY=true

# Authority over reads that return a plaintext credential -- independent of HUDU_WRITE_POLICY, which
# never covers them: asset_passwords.get returns password and otp_secret as an ordinary read. deny
# (the default) refuses every asset_passwords.* and password_folders.* operation, through the dispatchers
# and through hudu_find_asset_passwords_by_slug / hudu_get_password_folder alike. Scoped to the whole
# resource, not to the expand flag, because the secret comes back without expand. hudu_search is
# unaffected; it redacts those resources already.
HUDU_SECRET_READS=deny
# HUDU_SECRET_READS=allow    # permits plaintext credential reads; SDK search results stay redacted

# Only read under HUDU_WRITE_POLICY=allow_list. Comma-separated registry operation keys, e.g.
# articles.update,assets.create. It must be non-empty and every key must exist in the registry (and
# be a write) or the container fails at boot with the variable named. Ignored under deny/all.
# Allowing a write also allows the writes it delegates to (articles.patchSection -> articles.update).
# The write client is offered the write-effect keys and the delete client the destructive-effect
# keys from this one list: to reach the same coverage as `all` via an allow list, it must name
# every write and every destructive operation (the full key set is the node-hudu capability
# registry, published in MCP_TOOL_MANIFEST.md). The two-key line below is the minimal shape, not
# full coverage.
# HUDU_WRITE_ALLOW=articles.update,assets.create

PORT=8787
LOG_LEVEL=info

# The resources hudu_search and hudu_resolve_any may offer and query. Unset means the SDK's full
# searchable set (articles, asset_passwords, assets, companies, groups, password_folders, users,
# websites). Set it to the subset THIS deployment's Hudu API key can read, so a tool neither
# advertises a guaranteed-empty read nor leaks an authorization failure for a resource the key
# cannot reach. A Hudu API key inherits its user's role, so a "Reader" key may read fewer than all
# eight. Comma-separated, each name validated against the SDK's searchable set at boot. Applies to
# the cross-resource reads (hudu_search, hudu_resolve_any) and the same operations through
# hudu_read; the dedicated per-resource resolve tools are unaffected.
# HUDU_SEARCH_RESOURCES=articles,assets,companies,users,groups,websites

# Image tag docker-compose.yml builds and runs as. scripts/deploy.sh sets it to the git short SHA
# of the deployed commit, so the running container is always tied to a commit and the previous
# tag stays resolvable for rollback. Do not deploy by hand with it unset, and never tag :latest.
# Leave it out of .env — the deploy script exports it.
# HUDU_IMAGE_TAG=

